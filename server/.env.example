# IBM watsonx.ai / Granite
# Get these from: https://cloud.ibm.com/  +  https://dataplatform.cloud.ibm.com/
IBM_PROJECT_ID=your_watsonx_project_id_here
IBM_WATSON_API_KEY=your_ibm_cloud_api_key_here
IBM_WATSON_AI_URL=https://us-south.ml.cloud.ibm.com
IBM_GRANITE_MODEL_ID=ibm/granite-4-h-small

# Database
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/salinity_shield

# Application
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# JWT (optional - for user auth)
JWT_SECRET=change-this-to-a-random-secret-in-production
