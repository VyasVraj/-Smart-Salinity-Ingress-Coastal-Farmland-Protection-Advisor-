# Backend API URL (leave empty to use Vite proxy in development)
# VITE_API_URL=http://localhost:5000

# Google Maps JavaScript API key
# Obtain from: https://console.cloud.google.com/
# Required APIs: Maps JavaScript API
# Set HTTP referrer restrictions in Google Cloud Console for production.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Google Maps Map ID (optional — use 'DEMO_MAP_ID' for local development,
# or create a real Map ID in Google Cloud Console → Map Management for production).
# Required for AdvancedMarker support.
# VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
